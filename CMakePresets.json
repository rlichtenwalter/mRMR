{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release",
            "description": "Optimized build (-O3, LTO). Used by the mrmr CLI and benchmarks for production runs.",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Unoptimized build with debug symbols. Used for diagnosis and step debugging.",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "sanitize",
            "displayName": "Debug + ASan + UBSan",
            "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer. Used by the CI sanitize job and locally to reproduce sanitizer findings.",
            "inherits": "debug",
            "binaryDir": "${sourceDir}/build/sanitize",
            "cacheVariables": {
                "MRMR_SANITIZE": "ON"
            }
        },
        {
            "name": "continuous",
            "displayName": "Release + continuous/mixed MI (KSG)",
            "description": "Optimized build with MRMR_CONTINUOUS=ON. Fetches the pinned kdtree release and compiles the KSG estimators, which no other preset instantiates. Used by the CI continuous job.",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/continuous",
            "cacheVariables": {
                "MRMR_CONTINUOUS": "ON"
            }
        },
        {
            "name": "install-check",
            "displayName": "Release without tests",
            "description": "Optimized build with MRMR_BUILD_TESTS=OFF, so Catch2 is not fetched. Used by the CI install job, which validates the installed artifact only.",
            "inherits": "release",
            "binaryDir": "${sourceDir}/build/install-check",
            "cacheVariables": {
                "MRMR_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize"
        },
        {
            "name": "continuous",
            "configurePreset": "continuous"
        },
        {
            "name": "install-check",
            "configurePreset": "install-check"
        }
    ],
    "testPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitize",
            "configurePreset": "sanitize",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1:abort_on_error=1",
                "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "continuous",
            "configurePreset": "continuous",
            "output": {
                "outputOnFailure": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "ci",
            "displayName": "CI (release)",
            "description": "Configure, build and test the release preset in one command: cmake --workflow --preset ci.",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "test",
                    "name": "release"
                }
            ]
        }
    ]
}
